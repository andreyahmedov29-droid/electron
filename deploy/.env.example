# Скопируйте в deploy/.env и заполните нужное. Ничего не заполняйте —
# приложение работает и без этих переменных, на дефолтах.

# Основные
PORT=3000
DATA_DIR=/data

# Интеграция с порталом Битрикс24 (если приложение читает данные портала)
# BITRIX_API_KEY=
# BITRIX_API_BASE_URL=
# BITRIX_PORTAL_DOMAIN=
# PORTAL_TIMEOUT_MS=180000

# 1С (автоподтягивание накладных), если используется
# ONEC_API_URL=https://1c.prof-mc.ru/ut/hs/doks/shipment
# ONEC_API_USER=Администратор
# ONEC_API_PASS=

# Карты и маршрутизация (опционально)
# YANDEX_GEO_KEY=
# YANDEX_MAPS_KEY=
# GIS_API_KEY=
# TOMMOM_KEY=
# OSRM_URL=https://routing.openstreetmap.de/routed-car

# Автообновление APK и служебные
# APP_UPDATE_SOURCE_URL=
# APP_UPDATE_VERSION_CODE=
# APP_UPDATE_VERSION_NAME=
# APP_UPDATE_NOTES=
# APP_UPDATE_APK_URL=
# SERVER_UPDATE_TOKEN=
# APP_TZ_OFFSET_MIN=
