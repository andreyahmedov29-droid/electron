# Один контейнер для всего приложения (сервер + статика).
# Сборка контекста идёт из корня проекта: docker build -f deploy/Dockerfile .
FROM node:20-alpine

ENV NODE_ENV=production
ENV PORT=3000

WORKDIR /app

# Копируем код и статику (секреты/.env и данные исключены через .dockerignore).
COPY . .

# Внешних npm-зависимостей у приложения нет, поэтому установка мгновенная и
# нужна только на случай будущего добавления пакетов. Не роняет сборку, если
# реестр недоступен (устанавливать нечего).
RUN npm install --omit=dev --no-audit --no-fund || true

# Данные приложения лежат на внешнем томе — переживают пересоздание контейнера.
VOLUME ["/data"]

EXPOSE 3000

# Точка входа оставлена ровно той же, что в package.json ("start": "node server.js").
CMD ["node", "server.js"]
