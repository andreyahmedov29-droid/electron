{
  "name": "biotime-web",
  "version": "1.0.0",
  "description": "BIOTIME — веб-приложение (учёт рабочего времени, маршрутизация, движение водителей). Разворачивается на VibeCode платформе.",
  "author": "ПрофМаркетСистем",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {},
  "build": {
    "appId": "com.biotime.worklogger",
    "productName": "BIOTIME",
    "asar": false,
    "publish": [
      {
        "provider": "github",
        "owner": "andreyahmedov29-droid",
        "repo": "electron"
      }
    ],
    "files": [
      "server.js",
      "app.js",
      "index.html",
      "styles.css",
      "qr.js",
      "sw.js",
      "manifest.webmanifest",
      "icon-180.png",
      "icon-192.png",
      "icon-512.png",
      "icon-512.svg",
      "icon-maskable-512.png",
      "icon-maskable.svg",
      "ios-icon-1024.png",
      "ios-icon-180.png",
      "ios-icon.svg",
      "electron/**/*",
      "logo-biotime-dark.svg",
      "logo-biotime-mark.svg",
      "logo-biotime.svg",
      "sign-icon-512.png",
      "sign-icon-dark-512.png",
      "sign-icon-dark.svg",
      "sign-icon.svg",
      "package.json",
      "!**/*.log",
      "!**/.opencode/**",
      "!**/ios/**",
      "!**/dist/**",
      "!**/check-*.png",
      "!**/example-*",
      "!**/_before_design.png",
      "!**/export_test.xlsx"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon-512.png",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "category": "public.app-category.business",
      "icon": "icon-512.png",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
